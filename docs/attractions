    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #f8fafc; color: #1e293b; margin: 0; padding: 20px; line-height: 1.7; }
        header { background: linear-gradient(135deg, #0f172a, #1e3a8a); color: white; text-align: center; padding: 2.5rem 1rem; border-radius: 12px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
